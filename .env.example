# Sign-in credentials (default: admin / admin)
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me

# Long random string used to sign session cookies
AUTH_SECRET=

# Optional server-side fallbacks. Users normally connect their own key on the API page.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-codex
